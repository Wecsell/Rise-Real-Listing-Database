# Telegram Userbot Credentials (my.telegram.org)
TG_API_ID=
TG_API_HASH=

# LLM API
GEMINI_API_KEY=

# Airtable API
AIRTABLE_TOKEN=pat...
AIRTABLE_BASE_ID=app...
AIRTABLE_PROJECTS_TABLE=Projects
AIRTABLE_UNITS_TABLE=Units

# Google Drive Service Account Path
GOOGLE_SA_JSON=/secrets/rise-drive-bot.json

# Database Credentials
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://postgres:your_secure_password_here@postgres:5432/rise

# Bot Settings
OWNER_TG_ID=
DRY_RUN=1
HEALTHCHECK_PORT=8080

# Admin alerts (notify_admin in app/listener.py): a Telegram bot token/chat
# used to page an admin on pipeline errors and health-monitor transitions.
# If unset, the userbot sends the alert to its own "Saved Messages" instead.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# How often (seconds) the health monitor re-checks Telegram/DB connectivity
# on its own clock and alerts on a healthy<->unhealthy transition. Docker's
# own HEALTHCHECK only marks the container unhealthy internally; nobody is
# paged unless this loop is running.
HEALTH_MONITOR_INTERVAL_SECONDS=60

# Temporary MVP switch: skip the needs_human review queue so extractions sync
# straight through. There is no in-Telegram approval command yet (only
# `python -m app.sync_job --approve ID`), so leaving this off would stall the
# pipeline. Unset once a real review UI ships.
MVP_SKIP_HUMAN_REVIEW=0

# Режим автоматического разбора: off | gemini. См. app/llm_gate.py
LLM_BACKEND=off

# Предел вложенности при обходе папок Google Drive (1..12). См. app/drive_folder.py
GDRIVE_MAX_DEPTH=8
